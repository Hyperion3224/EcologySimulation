@using System.Text.Json

@model HomeModel;
@{
    ViewData["Title"] = "Home Page";
}
<script>
  window["seed"] = @Html.Raw(JsonSerializer.Serialize(Model.Seed));
  window["height"] = @Html.Raw(Model.Height);
  window["diameter"] = @Html.Raw(Model.Diameter);
  window["chunkSize"] = @Html.Raw(Model.ChunkSize);
  window["data"] = @Html.Raw(JsonSerializer.Serialize(Model.Data));
</script>

<div id="root">
    <h1 style="width: 100vw; height: 100vh; text-align: center; ">Loading...</h1>
</div>
<script type="module" src="~/views/page.js"> </script>
